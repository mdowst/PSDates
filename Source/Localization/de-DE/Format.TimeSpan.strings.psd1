@{
    Year  = @{ One = '{0} Jahr';    Other = '{0} Jahre' }
    Month = @{ One = '{0} Monat';   Other = '{0} Monate' }
    Day   = @{ One = '{0} Tag';     Other = '{0} Tage' }
    Hour  = @{ One = '{0} Stunde';  Other = '{0} Stunden' }
    Min   = @{ One = '{0} Minute';  Other = '{0} Minuten' }
    Sec   = @{ One = '{0} Sekunde'; Other = '{0} Sekunden' }

    Separator      = ', '
    NegativeSign   = '-'            # or '−' (U+2212) if you prefer
    ZeroFallback   = '0 Sekunden'
    IncludeZerosOn = '{0} {1}'
}
